{
  "name": "@peckey954/ui",
  "version": "0.1.0",
  "description": "Multi-brand design system built on shadcn/ui and Tailwind CSS v4, with first-class Thai font support. Swap colours and fonts per brand without touching component code.",
  "keywords": [
    "design-system",
    "shadcn",
    "shadcn-ui",
    "tailwindcss",
    "react",
    "radix-ui",
    "multi-brand",
    "design-tokens",
    "thai"
  ],
  "license": "MIT",
  "author": "peckey954",
  "homepage": "https://github.com/peckey954/ds#readme",
  "bugs": {
    "url": "https://github.com/peckey954/ds/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peckey954/ds.git",
    "directory": "packages/ui"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.544.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.83.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.2"
  }
}
